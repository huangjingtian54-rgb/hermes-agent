# Hermes Agent Configuration
# Copy this file to ~/.hermes/.env and fill in your values

# API Keys
GITHUB_TOKEN=your_github_token_here  # e.g., ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HUGGING_FACE_TOKEN=your_huggingface_token  # Optional

# Model Configuration
# Available providers: openai, omlx, ollama, custom
DEFAULT_PROVIDER=omlx
DEFAULT_MODEL=Qwen3.6-35B-A3B-4bit

# OpenAI Configuration (if using)
# OPENAI_API_KEY=your_openai_key

# Ollama Configuration (if using)
# OLLAMA_API_BASE=http://localhost:11434/v1

# Ollama Model Configuration
# OLLAMA_DEFAULT_MODEL=your_ollama_model

# OAuth (if using gateway)
# GATEWAY_URL=https://api.nousresearch.com
# GATEWAY_TOKEN=your_gateway_token

# GitHub Authentication
# GH_TOKEN=your_github_token  # Alternative to GITHUB_TOKEN

# Agent Configuration
# MAX_TURNS=60
# REASONING_EFFORT=none  # none, low, medium, high

# Terminal Configuration
# TERMINAL_BACKEND=local  # local, docker, pulsetraffic
# TERMINAL_TIMEOUT=180

# Browser Configuration
# BROWSER_TIMEOUT=120
# BROWSER_HEADLESS=false

# Memory Configuration
# MEMORY_ENABLED=true
# MEMORY_MAX_CHARS=5000

# Development Settings
# DEBUG=false
# VERBOSE=false
# LOG_LEVEL=info

# Performance Settings
# MAX_CONCURRENT_REQUESTS=1
# RATE_LIMIT_DELAY=0
